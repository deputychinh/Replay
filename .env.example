# Backend (read by app/core/config.py, prefix RELAY_). Defaults already match `make up`.
RELAY_ENV=local
RELAY_DATABASE_URL=postgresql+asyncpg://relay:relay@localhost:5442/relay
RELAY_REDIS_URL=redis://localhost:6389/0
RELAY_JWT_SECRET=change-me-local-only-32-characters!
RELAY_APP_URL=http://localhost:5190
RELAY_AWS_ENDPOINT_URL=http://localhost:4566
RELAY_AWS_PUBLIC_ENDPOINT_URL=http://localhost:4566
RELAY_QUEUE_URL=http://localhost:4566/000000000000/relay-jobs
RELAY_FILES_BUCKET=relay-files
RELAY_EMAIL_BACKEND=smtp
RELAY_SMTP_HOST=localhost
RELAY_SMTP_PORT=1026
