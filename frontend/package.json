{
  "name": "relay-frontend",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/api-client",
    "packages/design-tokens",
    "web"
  ],
  "scripts": {
    "gen-client": "npm run generate -w @relay/api-client",
    "dev": "npm run dev -w @relay/web",
    "build": "npm run build -w @relay/web",
    "test": "npm run test -w @relay/web",
    "lint": "eslint . && stylelint \"web/src/**/*.css\" \"packages/design-tokens/*.css\"",
    "typecheck": "npm run typecheck -w @relay/web",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "stylelint-selector-bem-pattern": "^5.0.0",
    "typescript-eslint": "^8.71.1"
  }
}
